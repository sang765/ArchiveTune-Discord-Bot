[Unit]
Description=Discord Forum Tag Manager Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=discordbot
Group=discordbot
WorkingDirectory=/opt/discord-forum-bot
Environment=CONFIG_FILE=/opt/discord-forum-bot/config.yaml
ExecStart=/opt/discord-forum-bot/bin/discord-forum-bot
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/discord-forum-bot

[Install]
WantedBy=multi-user.target
